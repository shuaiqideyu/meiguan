# systemd 的 EnvironmentFile 会读这个文件。不要写 export，不要加引号。

# 主体
BOT_TOKEN=
# 管理页地址，须与隧道主机名一致，不要末尾斜杠。
WEB_ORIGIN=https://hb.example.com
# 作者的 Telegram 数字 id。只有这个号能审核投稿、管理系统屏蔽。
AUTHOR_ID=
REDIS_URL=redis://127.0.0.1:6379/0
WEB_PORT=8780

# 节点。主体不要填 NODE_ID。
# NODE_ID=mia
# API_ID=
# API_HASH=
# HEADLESS=true

# 网页验证和表情算式。只写在节点上。
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3.5-flash
# VISION_MODELS=qwen3.5-flash:flash,qwen3.5-plus:plus

# 管理员的 Cloudflare 打码（CapMonster）。其他人在页面里填写。
# CAPMONSTER_KEY=

# 管理员的 hCaptcha 和滑块打码（2Captcha）。其他人在页面里填写。
# TWOCAPTCHA_KEY=
